#include <iostream>
using namespace std;

int main() {
    int age;

    do {
        cout << "Введите ваш возраст: ";
        cin >> age;

        if (age < 1 || age > 120) {
            cout << "Ошибка! Возраст должен быть от 1 до 120. Попробуйте снова." << endl;
        }
    } while (age < 1 || age > 120);

    cout << "Отлично! Вам " << age << " лет. Добро пожаловать!" << endl;

    return 0;
}


#include <iostream>
using namespace std;

int main() {
    int balance = 1500; // начальный баланс
    int choice;

    do {
        // Вывод меню
        cout << "\n=== МЕНЮ ===" << endl;
        cout << "1. Проверить баланс" << endl;
        cout << "2. Купить кофе (150 руб)" << endl;
        cout << "3. Выход" << endl;
        cout << "Ваш выбор: ";
        cin >> choice;

        // Обработка выбора
        switch (choice) {
            case 1:
                cout << "Ваш баланс: " << balance << " руб." << endl;
                break;
            case 2:
                if (balance >= 150) {
                    balance -= 150;
                    cout << "Кофе куплен! Остаток: " << balance << " руб." << endl;
                } else {
                    cout << "Недостаточно средств для покупки кофе!" << endl;
                }
                break;
            case 3:
                cout << "Спасибо за использование терминала. До свидания!" << endl;
                break;
            default:
                cout << "Неизвестная команда" << endl;
        }
    } while (choice != 3);

    return 0;
}
